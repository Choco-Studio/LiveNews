# Server
HOST=127.0.0.1
PORT=8080

# AI providers, in order: the first one that works writes the episode; if it
# fails or runs out of quota the next one takes over.
# Options: codex, openai, deepseek, inbox, mock
PROVIDERS=codex,openai,deepseek,mock

# --- Codex (uses your ChatGPT plan; run `codex login` first; Codex CLI >= 0.155) ---
CODEX_BIN=codex
CODEX_MODEL=gpt-6-luna
# Extra arguments for `codex exec`, separated by spaces
CODEX_EXTRA_ARGS=-c model_reasoning_effort=low
CODEX_TIMEOUT_MS=240000

# --- OpenAI API (paid, fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek (paid, fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Inbox (an external agent or a person acts as the AI; add `inbox` to PROVIDERS) ---
# Each request is written as <seq>-<stage>-<programme>.prompt.md (+ .request.json) in this
# folder; the answer goes next to it as .response.txt (or .json) plus an empty .done marker.
# If nobody answers within the timeout the next provider in PROVIDERS takes over.
AI_INBOX_DIR=data/ai-inbox
AI_INBOX_TIMEOUT_MS=1800000

# Channel line-up (programmes, presenters, rotation, recurring features) lives in
# config/channel.json and news sources in config/feeds.json. FEEDS_FILE points to
# another list, e.g. config/feeds.fixture.json: five fictional outlets with sample
# stories in real places and original pictures, works offline (npm run demo:offline).
FEEDS_FILE=config/feeds.json

# Episodes produced ahead of air
QUEUE_SIZE=2
# Start the channel at this programme of the rotation (demos, recordings), e.g. world-weather
ROTATION_START=
# Long programmes in parts (config/channel.json format.parts: WORLD NOW in four parts, ~26 min): on / off
PROGRAMME_PARTS=on
# The hourly clock (config/schedule.json: NEWS IN 60 at :00 and :30, WORLD NOW at :01:30...): on / off (rotation)
CLOCK=on
# Stories offered to the writer, who picks the best ones for each programme
CANDIDATE_POOL=12
# Second AI pass: a standards editor checks every script against its sources (1/0)
REVIEW_PASS=1
# Minimum fresh stories a programme needs to air a new episode
MIN_NEW_STORIES=3
# Maximum story age in hours
MAX_STORY_AGE_HOURS=36
FEED_REFRESH_MINUTES=10
# Picture desk: milliseconds per episode to look for pictures on article pages,
# and to download each picture once before air (a failing one is replaced or dropped)
PICTURE_BUDGET_MS=6000
PICTURE_VERIFY_MS=12000
# Short of new stories, re-run those aired longest ago (never the last RECYCLE_GAP
# episodes'): local (offline fixture desk only), all (live feeds too, stories aired
# at least RECYCLE_AFTER_HOURS ago) or off
RECYCLE_STORIES=local
RECYCLE_AFTER_HOURS=4
RECYCLE_GAP=6
# Hours the station remembers the presenters' own lines and its features (number of the day, "And finally"):
# the line aired longest ago is used first, and a chat line aired within them is not aired again
RECENT_LINES_HOURS=6
# (numbers outside their range fall back to the default with a warning at start-up)

# --- Presenter voices ---
# kokoro (recommended): every spoken segment is synthesised on this machine
# ahead of air with local neural voices (Kokoro; models: tools/voice/fetch-models.sh,
# cast in server/voice/casting.json) and cached in data/voice/. browser (the
# default without a .env): the viewer's own speechSynthesis reads the scripts.
# If Kokoro is missing the channel logs it once and falls back to browser voices.
VOICE_ENGINE=kokoro
# Folder with kokoro-v1.0.onnx and voices-v1.0.bin (empty: data/models, then ~/.cache/kokoro)
KOKORO_DIR=
# CPU threads for the voice model (0 = all); lower it if OBS or the browser stutter
KOKORO_THREADS=0
VOICE_PYTHON=python3
# Voice processes working in parallel (~0.6 GB of memory each); raise it only on a
# machine with spare cores where one process cannot keep up with the schedule
VOICE_WORKERS=1
# Seconds an episode waits for its voices before it is queued anyway; clips that
# finish later are still used when their segment airs
VOICE_BUDGET_S=90
# The first programme after start waits for ALL its voices, up to this many seconds (nothing is on air yet)
VOICE_FIRST_BUDGET_S=480
# Size limit of the voice cache in data/voice/ (MB); the oldest clips are removed first
VOICE_CACHE_MB=300

# --- Real photos (owner: on air only real photos found on the web) ---------------
# Stories the feeds and article pages leave without a picture get a FILE photo of
# their place: 'commons' (Wikimedia Commons, no key, free licences only) by
# default; add google and/or bing with their keys (comma-separated); 'off' = none
IMAGE_SEARCH=commons
# Google Programmable Search (image search, Creative Commons rights filter)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Bing Image Search (licence filter: Share)
BING_IMAGE_KEY=

# --- Pictures that may air (docs/roadmap/FOTOS_LIBRES.md) ---------------------------
# 'outlet' (default): the outlets' own pictures. 'free': only freely licensed pictures
# (Wikidata + Wikimedia Commons, licence and provenance checked; for YouTube);
# 'free-strict': the same without CC BY-SA. Free modes never air outlet pictures.
PICTURES=outlet
# Time the free-picture desk may take per programme (ms)
FREE_PICTURE_BUDGET_MS=30000
# Pixabay API key (pixabay.com/api/docs/, free): stock scenes in the free modes; empty = no stock
PIXABAY_API_KEY=

# --- Footage for the correspondent links (WORLD NOW, owner 4 Oct) ---------------------
# Moving pictures of a link's place (never the event, never on a grave story): FILE
# clips from Wikimedia Commons, kept in data/footage/ and pixelated by the client.
# 'auto' = on with live feeds, off on the offline fixture feeds; 'on'; 'off'
FOOTAGE=auto
# How long an episode in production waits for its links' clips (ms); a late clip airs
# without footage (the link shows the story's picture or its map)
FOOTAGE_BUDGET_MS=20000
# Size limit of data/footage/ (MB); the oldest clips are removed first
FOOTAGE_CACHE_MB=400

# --- WORLD WEATHER (real forecast data) ------------------------------------------
# auto = Open-Meteo live (api.open-meteo.com, no key), or the offline DEMO data
# (shown as such on screen) while the news desk runs on the fixture feeds;
# open-meteo | fixture | off. A failed live fetch skips the programme.
WEATHER=auto
# Warnings panel: gdacs (www.gdacs.org: tropical cyclones, floods, droughts,
# wildfires on orange or red alert) or off
WEATHER_WARNINGS=gdacs
# Minutes a forecast is reused before it is fetched again
WEATHER_TTL_MIN=30
