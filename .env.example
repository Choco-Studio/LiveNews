# Server
HOST=127.0.0.1
PORT=8080

# AI providers, in order: the first one that works writes the episode; if it
# fails or runs out of quota the next one takes over.
# Options: anthropic, codex, openai, deepseek, inbox, mock
PROVIDERS=anthropic,codex,openai,deepseek,mock

# --- Claude (the Anthropic API; paid per use) ---
# Keep the key on the server only (/etc/globit24.env, chmod 600): never in this file in the repository.
ANTHROPIC_API_KEY=
# The model id, set on the server next to the key
ANTHROPIC_MODEL=
# How much the model thinks before it writes: low, medium, high, xhigh or max. Empty: the model's default.
ANTHROPIC_EFFORT=
# Room for the thinking plus the longest script
ANTHROPIC_MAX_TOKENS=32000
# The whole request is cut after this long; the SDK itself retries rate limits and dropped connections
ANTHROPIC_TIMEOUT_MS=240000
ANTHROPIC_MAX_RETRIES=2

# --- Codex (uses your ChatGPT plan; run `codex login` first; Codex CLI >= 0.155) ---
CODEX_BIN=codex
CODEX_MODEL=gpt-6-luna
# Extra arguments for `codex exec`, separated by spaces
CODEX_EXTRA_ARGS=-c model_reasoning_effort=low
CODEX_TIMEOUT_MS=240000

# --- OpenAI API (paid, fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek (paid, fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Inbox (an external agent or a person acts as the AI; add `inbox` to PROVIDERS) ---
# Each request is written as <seq>-<stage>-<programme>.prompt.md (+ .request.json) in this
# folder; the answer goes next to it as .response.txt (or .json) plus an empty .done marker.
# If nobody answers within the timeout the next provider in PROVIDERS takes over.
AI_INBOX_DIR=data/ai-inbox
AI_INBOX_TIMEOUT_MS=1800000

# Channel line-up (programmes, presenters, rotation, recurring features) lives in
# config/channel.json and news sources in config/feeds.json. FEEDS_FILE points to
# another list, e.g. config/feeds.fixture.json: five fictional outlets with sample
# stories in real places and original pictures, works offline (npm run demo:offline).
FEEDS_FILE=config/feeds.json

# The article cache (data/compliance/articles): the text the news desk already read for each aired story, kept 14
# days so clips and posts can be checked against the outlet's words. Nothing is fetched for it. off keeps nothing; a
# feed with "cache": false in the feeds file is never kept.
ARTICLE_CACHE=on

# Episodes produced ahead of air
QUEUE_SIZE=2
# Pre-rendered playout (docs/publishing/playout.md): set by tools/playout/station.mjs, never by hand; its folder
PLAYOUT=
PLAYOUT_DIR=
# The channel's public stream (its watch page). Unset (the manual beta): no stream, so nothing on screen says LIVE
# and no end card promises a stream; set with PLAYOUT: "news 24 hours a day", never LIVE
CHANNEL_LIVE_URL=
# Start the channel at this programme of the rotation (demos, recordings), e.g. world-weather
ROTATION_START=
# A draft programme on air for a test or a recording (never the official line-up): its id, at the end of the rotation,
# or id@slot right after that slot, e.g. full-time@world-weather. Empty: drafts never air.
DRAFTS_ON_AIR=
# PAY ATTENTION as a draft on air (DRAFTS_ON_AIR=pay-attention@cosmos) for viewing or a recording before the archive
# holds three days: 1 lifts the quiz's three-day minimum and its overnight hours for that draft only (never for air).
QUIZ_VIEW=
# The channel's clock (config/channel.json "clock": NEWS IN 60 at :00 and :30 London time, MONEY MINUTE 06-22 on
# weekdays): 1 on, 0 the bare rotation. Empty: on, except for a ROTATION_START demo
STATION_CLOCK=
# Stories offered to the writer, who picks the best ones for each programme
CANDIDATE_POOL=12
# Second AI pass: a standards editor checks every script against its sources (1/0)
REVIEW_PASS=1

# IN THEIR WORDS, re-staged: a public figure a story quotes says their own sourced words as a labelled
# recreation (server/guests/restage.js). 0 turns every recreation back into a quote card.
RESTAGE=1
# Minimum fresh stories a programme needs to air a new episode
MIN_NEW_STORIES=3
# Maximum story age in hours
MAX_STORY_AGE_HOURS=36
FEED_REFRESH_MINUTES=10
# Picture desk: milliseconds per episode to look for pictures on article pages,
# and to download each picture once before air (a failing one is replaced or dropped)
PICTURE_BUDGET_MS=6000
PICTURE_VERIFY_MS=12000
# Short of new stories, re-run those aired longest ago (never the last RECYCLE_GAP
# episodes'): all (live feeds too, stories aired at least RECYCLE_AFTER_HOURS ago: a
# rolling news channel tells its stories again through the day), local (offline
# fixture desk only: live feeds then run dry within hours) or off
RECYCLE_STORIES=all
RECYCLE_AFTER_HOURS=2
RECYCLE_GAP=6
# Hours the station remembers the presenters' own lines and its features (number of the day, "And finally"):
# the line aired longest ago is used first, and a chat line aired within them is not aired again
RECENT_LINES_HOURS=6
# (numbers outside their range fall back to the default with a warning at start-up)

# --- Presenter voices ---
# kokoro (recommended): every spoken segment is synthesised on this machine
# ahead of air with local neural voices (Kokoro; models: tools/voice/fetch-models.sh,
# cast in server/voice/casting.json) and cached in data/voice/. browser (the
# default without a .env): the viewer's own speechSynthesis reads the scripts.
# If Kokoro is missing the channel logs it once and falls back to browser voices.
VOICE_ENGINE=kokoro
# Folder with kokoro-v1.0.onnx and voices-v1.0.bin (empty: data/models, then ~/.cache/kokoro)
KOKORO_DIR=
# The voice model's weights: empty or fp32 (the default: the weights the cast was chosen on), fp16 (the release's
# smaller file: about 15 % less CPU, but measured a little less natural and 2 % slower to read, so only if the owner
# hears no difference; fetch it with tools/voice/fetch-models.sh --model fp16) or int8 (slower than fp32 on the
# machines measured). A file that is not installed falls back to fp32. See docs/roadmap/critique/voices-speed.md.
VOICE_MODEL=
# CPU threads for the voice model (empty or 0: the default, 1). One thread costs the least CPU per second of speech
# beside a busy renderer; 2 makes each clip faster only while a core is idle, for more CPU. 'auto': one per core.
KOKORO_THREADS=
VOICE_PYTHON=python3
# Voice processes working in parallel (~0.6 GB of memory each); raise it only on a
# machine with spare cores where one process cannot keep up with the schedule
VOICE_WORKERS=1
# Seconds an episode waits for its voices before it is queued anyway; clips that
# finish later are still used when their segment airs
VOICE_BUDGET_S=90
# The first programme after start waits for ALL its voices, up to this many seconds (nothing is on air yet)
VOICE_FIRST_BUDGET_S=480
# Size limit of the voice cache in data/voice/ (MB); the oldest clips are removed first
VOICE_CACHE_MB=300
# Short phrases said again inside new clips (greetings, hand-overs, sign-offs), kept as Kokoro made them in
# data/voice/phrases (MB; 0 = off): the same samples without the model pass
VOICE_PHRASE_CACHE_MB=64

# --- Real photos (owner: on air only real photos found on the web) ---------------
# Stories the feeds and article pages leave without a picture get a FILE photo of
# their place: 'commons' (Wikimedia Commons, no key, free licences only) by
# default; add google and/or bing with their keys (comma-separated); 'off' = none
IMAGE_SEARCH=commons
# Google Programmable Search (image search, Creative Commons rights filter)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Bing Image Search (licence filter: Share)
BING_IMAGE_KEY=

# --- Picture rights (owner 17 Oct: "no sanction risk and no loss of quality") -----
# Only pictures the channel may publish air, each with its rights record
# (docs/pictures/RIGHTS.md): Wikidata subjects and Commons, NASA, Commons FILE photos
# of the place. 'cleared' (default). 'preview' lets the outlets' own photos stand in
# where nothing cleared fits, for a PRIVATE preview only: the screen says PREVIEW ·
# NOT CLEARED and the episode is marked never to be published.
PICTURE_RIGHTS=cleared
# The rights desk looks for cleared pictures; 0 = it does not (maps and boards instead)
PICTURE_DESK=1
# Who runs this channel, for the User-Agent Wikimedia's rate limits ask for (an email
# or a URL of the operator); without one Wikimedia allows a handful of requests a minute
WIKIMEDIA_CONTACT=https://github.com/choco-studio/livenews
# Openverse: institutions' own Flickr pictures (a presidency, a parliament), asked
# anonymously (200 requests a day announced; the desk stays under OPENVERSE_DAILY)
OPENVERSE=1
OPENVERSE_DAILY=150
# The face reader (tools/pictures/faces.mjs, headless Chromium): run and watched by the station,
# started again if it stops. off: never run (a grave story's portrait then never airs)
FACE_READER=1
# The desk decides ahead of air, in the background, as stories come in (the next programmes' first); each
# episode only reads the decisions that are ready. off: decide within each episode's picture budget instead
PICTURES_AHEAD=1
# ...and, when nothing on the news desk is waiting, the week's archived stories (PAY ATTENTION's PICTURE THIS)
PICTURES_ARCHIVE=1

# --- Footage for the correspondent links (WORLD NOW, owner 4 Oct) ---------------------
# Moving pictures of a link's place (never the event, never on a grave story): FILE
# clips from Wikimedia Commons, kept in data/footage/ and pixelated by the client.
# 'auto' = on with live feeds, off on the offline fixture feeds; 'on'; 'off'
FOOTAGE=auto
# How long an episode in production waits for its links' clips (ms); a late clip airs
# without footage (the link shows the story's picture or its map)
FOOTAGE_BUDGET_MS=20000
# Size limit of data/footage/ (MB); the oldest clips are removed first
FOOTAGE_CACHE_MB=400

# --- WORLD WEATHER (real forecast data) ------------------------------------------
# auto = Open-Meteo live (api.open-meteo.com, no key), or the offline DEMO data
# (shown as such on screen) while the news desk runs on the fixture feeds;
# open-meteo | fixture | off. A failed live fetch skips the programme.
WEATHER=auto
# Warnings panel: gdacs (www.gdacs.org: tropical cyclones, floods, droughts,
# wildfires on orange or red alert) or off
WEATHER_WARNINGS=gdacs
# Minutes a forecast is reused before it is fetched again
WEATHER_TTL_MIN=60
