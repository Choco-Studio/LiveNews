# Server
HOST=127.0.0.1
PORT=8080

# AI providers, in order: the first one that works writes the episode; if it
# fails or runs out of quota the next one takes over.
# Options: codex, openai, deepseek, inbox, mock
PROVIDERS=codex,openai,deepseek,mock

# --- Codex (uses your ChatGPT plan; run `codex login` first; Codex CLI >= 0.155) ---
CODEX_BIN=codex
CODEX_MODEL=gpt-6-luna
# Extra arguments for `codex exec`, separated by spaces
CODEX_EXTRA_ARGS=-c model_reasoning_effort=low
CODEX_TIMEOUT_MS=240000

# --- OpenAI API (paid, fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek (paid, fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Inbox (an external agent or a person acts as the AI; add `inbox` to PROVIDERS) ---
# Each request is written as <seq>-<stage>-<programme>.prompt.md (+ .request.json) in this
# folder; the answer goes next to it as .response.txt (or .json) plus an empty .done marker.
# If nobody answers within the timeout the next provider in PROVIDERS takes over.
AI_INBOX_DIR=data/ai-inbox
AI_INBOX_TIMEOUT_MS=1800000

# Channel line-up (programmes, presenters, rotation, recurring features) lives in
# config/channel.json and news sources in config/feeds.json. FEEDS_FILE points to
# another list, e.g. config/feeds.fixture.json: five fictional outlets with sample
# stories in real places and original pictures, works offline (npm run demo:offline).
FEEDS_FILE=config/feeds.json

# Episodes produced ahead of air
QUEUE_SIZE=2
# Stories offered to the writer, who picks the best ones for each programme
CANDIDATE_POOL=12
# Second AI pass: a standards editor checks every script against its sources (1/0)
REVIEW_PASS=1
# Minimum fresh stories a programme needs to air a new episode
MIN_NEW_STORIES=3
# Maximum story age in hours
MAX_STORY_AGE_HOURS=36
FEED_REFRESH_MINUTES=10
# Picture desk: milliseconds per episode to look for pictures on article pages,
# and to download each picture once before air (a failing one is replaced or dropped)
PICTURE_BUDGET_MS=6000
PICTURE_VERIFY_MS=12000
# Short of new stories, re-run those aired longest ago (never the last RECYCLE_GAP
# episodes'): local (offline fixture desk only), all (live feeds too, stories aired
# at least RECYCLE_AFTER_HOURS ago) or off
RECYCLE_STORIES=local
RECYCLE_AFTER_HOURS=4
RECYCLE_GAP=5

# --- Presenter voices ---
# kokoro (recommended): every spoken segment is synthesised on this machine
# ahead of air with local neural voices (Kokoro; models: tools/voice/fetch-models.sh,
# cast in server/voice/casting.json) and cached in data/voice/. browser (the
# default without a .env): the viewer's own speechSynthesis reads the scripts.
# If Kokoro is missing the channel logs it once and falls back to browser voices.
VOICE_ENGINE=kokoro
# Folder with kokoro-v1.0.onnx and voices-v1.0.bin (empty: data/models, then ~/.cache/kokoro)
KOKORO_DIR=
# CPU threads for the voice model (0 = all); lower it if OBS or the browser stutter
KOKORO_THREADS=0
VOICE_PYTHON=python3
# Voice processes working in parallel (~0.6 GB of memory each); raise it only on a
# machine with spare cores where one process cannot keep up with the schedule
VOICE_WORKERS=1
# Seconds an episode waits for its voices before it is queued anyway; clips that
# finish later are still used when their segment airs
VOICE_BUDGET_S=90
# Size limit of the voice cache in data/voice/ (MB); the oldest clips are removed first
VOICE_CACHE_MB=300
